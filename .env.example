# angoshtarbaz-backend origin (no trailing slash).
# Default matches the ANG-A0 contract and backend CORS ADMIN_ORIGIN notes.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional alias kept from the scaffold (ignored when NEXT_PUBLIC_API_URL is set).
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Gallery (ANG-A3) uses the same origin. Mock storage is default on the backend
# (PUT /gallery/upload/:key?token= + GET /gallery/files/:key). S3 uses the same
# presign → browser PUT uploadUrl → POST /gallery contract. The PUT does not
# send the admin JWT.
