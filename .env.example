# NestJS origin (no trailing slash). Must be the Nest origin.
# Admin runs on http://localhost:3001; the mock API runs on http://localhost:3002.
# An empty or whitespace-only value is ignored and falls back to the default
# (http://localhost:3000).
NEXT_PUBLIC_API_URL=http://localhost:3000

# Optional alias kept from the scaffold (ignored when NEXT_PUBLIC_API_URL is set).
# An empty value is also ignored.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Optional override if the backend login path is not POST /auth/login.
# API_LOGIN_PATH=/auth/login

# Gallery (ANG-A3) uses the same origin. Mock storage is default on the backend
# (PUT /gallery/upload/:key + GET /gallery/files/:key). S3 uses the same
# presign → PUT uploadUrl → POST /gallery contract.
