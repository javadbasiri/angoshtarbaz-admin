# Required. NestJS backend origin (no trailing slash).
# angoshtarbaz-backend listens on PORT || 3000, with no global prefix.
# This value is inlined at build time — restart `next dev` or rebuild after changing it.
# The admin dev server runs on :3001 (same as the backend's default ADMIN_ORIGIN).
NEXT_PUBLIC_API_URL=http://localhost:3000

# Optional: local mock API (`npm run mock-api`, MOCK_API_PORT default 3002).
# NEXT_PUBLIC_API_URL=http://localhost:3002

# Optional alias kept from the scaffold (ignored when NEXT_PUBLIC_API_URL is set).
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Optional override if the backend login path is not POST /auth/login.
# API_LOGIN_PATH=/auth/login

# Gallery (ANG-A3) uses the same origin. Mock storage is default on the backend
# (PUT /gallery/upload/:key + GET /gallery/files/:key). S3 uses the same
# presign → PUT uploadUrl → POST /gallery contract.
