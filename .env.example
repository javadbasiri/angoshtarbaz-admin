# NestJS origin (no trailing slash). Must be the Nest origin.
# angoshtarbaz-backend listens on PORT || 3000, with no global prefix.
# Admin runs on http://localhost:3001 (same as the backend's default ADMIN_ORIGIN).
# The mock API (`npm run mock-api`) listens on http://localhost:3002.
# This value is inlined at build time — restart `next dev` or rebuild after changing it.
# An empty or whitespace-only value is ignored and falls back to the default
# (http://localhost:3000).
NEXT_PUBLIC_API_URL=http://localhost:3000

# Optional: local mock API (`npm run mock-api`, MOCK_API_PORT default 3002).
# NEXT_PUBLIC_API_URL=http://localhost:3002

# Optional alias kept from the scaffold (ignored when NEXT_PUBLIC_API_URL is set).
# An empty value is also ignored.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Gallery (ANG-A3) uses the same origin. Mock storage is default on the backend
# (PUT /gallery/upload/:key?token= + GET /gallery/files/:key). S3 uses the same
# presign → browser PUT uploadUrl → POST /gallery contract. The PUT does not
# send the admin JWT.

# ANG-A6 folder-first gallery. Off by default so /gallery stays the flat ANG-A3
# library. Set to 1 to enable the folder UI. Data is an in-memory stub that
# mirrors Nest (not called in this build):
#   GET    /gallery/browse?prefix=&delimiter=/
#   POST   /gallery/folders
#   POST   /gallery/folders/rename
#   DELETE /gallery/folders?prefix=
#   POST   /gallery/objects/move
#   POST   /gallery/presign  with filename, mime, size, and prefix
# Empty or any value other than 1 / true is off. Inlined at build time —
# restart `next dev` or rebuild after changing it.
# NEXT_PUBLIC_GALLERY_FOLDERS=1
